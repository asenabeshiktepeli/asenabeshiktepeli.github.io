    },
    {
      "parameters": {
        "jsCode": "// Sample project: sets priority, request ID and follow-up date\nconst f = $input.first().json;\nconst type = f['Request type'];\nconst priority = type === 'Damaged item' ? 'High' : type === 'Late delivery' ? 'Medium' : 'Normal';\nconst now = $now.setZone('Asia/Famagusta');\nlet follow = now.plus({ days: priority === 'High' ? 1 : 2 }).set({ hour: 10, minute: 0, second: 0, millisecond: 0 });\nwhile (follow.weekday > 5) follow = follow.plus({ days: 1 }); // skip weekends\nreturn [{ json: {\n  requestId: 'REQ-' + now.toFormat('yyMMdd-HHmmss'),\n  submittedAt: now.toFormat('yyyy-MM-dd HH:mm'),\n  customerName: f['Customer name'],\n  customerEmail: f['Customer email'],\n  orderNumber: f['Order number'],\n  requestType: type,\n  details: f['Details'],\n  priority,\n  followUpDate: follow.toFormat('yyyy-MM-dd'),\n  followUpStart: follow.toISO(),\n  followUpEnd: follow.plus({ minutes: 15 }).toISO()\n} }];"
      },
      "name": "Set priority & follow-up date",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        32
      ],
      "id": "ba10053b-bc51-4229-9978-fbe40ffde271"
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "workspace": "YOUR_ASANA_ID",
        "name": "=[{{ $json.priority }}] {{ $json.requestType }} - {{ $json.orderNumber }} - {{ $json.customerName }}",
        "otherProperties": {
          "assignee": "YOUR_ASANA_ID",
          "due_on": "={{ $json.followUpDate }}",
          "notes": "=Request ID: {{ $json.requestId }}\nCustomer: {{ $json.customerName }} ({{ $json.customerEmail }})\nOrder: {{ $json.orderNumber }}\nType: {{ $json.requestType }}\nPriority: {{ $json.priority }}\n\nDetails:\n{{ $json.details }}\n\nSample project - fictional data.",
          "projects": [
            "YOUR_ASANA_ID"
          ]
        }
      },
